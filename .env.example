# Sukuna Bot - Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development

# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Database
DATABASE_PATH=./data/sukuna.db
DB_MIGRATIONS=true
DB_CONNECTION_LIMIT=10

# Commands
COMMAND_PREFIX=!
COMMAND_CASE_INSENSITIVE=true

# Leveling
LEVELING_MEMBER_ROLE_ID=your_member_role_id
LEVELING_STAFF_ROLE_ID=your_staff_role_id
LEVELING_QUEEN_STAFF_ROLE_ID=your_queen_staff_role_id
LEVELING_LEVELS_CHANNEL_ID=your_levels_channel_id
LEVELING_STAFF_CMD_CHANNEL_ID=your_staff_cmd_channel_id
LEVELING_DISTINCT_ROLE_ID=your_distinct_member_role_id
LEVELING_DISTINCT_LEVEL=5
LEVELING_LOYAL_ROLE_ID=your_loyal_member_role_id
LEVELING_LOYAL_LEVEL=15
XP_PER_MESSAGE_MIN=15
XP_PER_MESSAGE_MAX=25
XP_COOLDOWN_SECONDS=60
XP_FORMULA=quadratic
BASE_XP_PER_LEVEL=100
XP_MULTIPLIER=1
XP_WEEKEND_MULTIPLIER=1.5
XP_BOOSTER_MULTIPLIER=2.0
MAX_LEVEL=100

# AI
AI_DISPLAY_NAME=Sukuna
AI_MODEL=gemini-1.5-flash
AI_SYSTEM_PROMPT=You are Sukuna, a helpful and powerful Discord bot assistant.
AI_CHANNEL_IDS=channel_id1,channel_id2
AI_HISTORY_SIZE=30
AI_BATCH_WINDOW_MS=2500
AI_REPLY_COOLDOWN_SECONDS=25
AI_DECISION_COOLDOWN_SECONDS=10
AI_MAX_REPLIES_PER_HOUR=40
AI_MAX_MESSAGE_LENGTH=500
AI_TEMPERATURE=1
AI_REQUEST_TIMEOUT_MS=20000
GEMINI_API_KEY=your_gemini_api_key_here

# TempVC
# Configured via /tempvc setup command

# Web Dashboard
SERVER_PORT=3000
