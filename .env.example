# Sukuna Bot - Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development

# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Logging
LOG_LEVEL=info
LOG_FORMAT=pretty

# Database
DATABASE_PATH=./data/sukuna.db
DB_MIGRATIONS=true
DB_CONNECTION_LIMIT=10

# Commands
COMMAND_PREFIX=!
COMMAND_CASE_INSENSITIVE=true

# Leveling
LEVELING_ENABLED=true
LEVELING_XP_FORMULA=quadratic
LEVELING_BASE_XP_PER_LEVEL=100
LEVELING_XP_MULTIPLIER=1
LEVELING_CUSTOM_XP_TABLE={}
XP_SOURCE_MESSAGE=true
XP_SOURCE_MESSAGE_MIN=15
XP_SOURCE_MESSAGE_MAX=25
XP_SOURCE_MESSAGE_COOLDOWN=60
XP_SOURCE_VOICE=true
XP_SOURCE_VOICE_MIN=5
XP_SOURCE_VOICE_MAX=8
XP_SOURCE_VOICE_COOLDOWN=60
XP_SOURCE_COMMAND=true
XP_SOURCE_COMMAND_AMOUNT=10
XP_SOURCE_COMMAND_COOLDOWN=300
XP_MULTIPLIER_WEEKEND=1.5
XP_MULTIPLIER_BOOSTER=2.0
XP_MULTIPLIER_ROLES={}
XP_NO_CHANNELS=[]
XP_CHANNEL_WHITELIST=[]
LEVELING_LEVEL_ROLES=[{"level":5,"roleId":"","replaceLower":false},{"level":15,"roleId":"","replaceLower":false}]
LEVELING_ANNOUNCEMENT_CHANNELS=[{"channelId":"","minLevel":1,"color":"#0099ff"},{"channelId":"","minLevel":1,"color":"#ffd700"}]
LEVELING_DEFAULT_COLOR=#0099ff
LEVELING_IGNORE_BOTS=true
LEVELING_MAX_LEVEL=100

# AI
AI_DISPLAY_NAME=Sukuna
AI_MODEL=gemini-1.5-flash
AI_SYSTEM_PROMPT=You are Sukuna, a helpful and powerful Discord bot assistant.
AI_PROVIDER=gemini
# AI_BASE_URL=                  # only for openai-compatible providers
# AI_API_KEY=                   # overrides GEMINI_API_KEY when set
AI_CHANNEL_IDS=channel_id1,channel_id2
AI_HISTORY_SIZE=30
AI_BATCH_WINDOW_MS=2500
AI_REPLY_COOLDOWN_SECONDS=25
AI_DECISION_COOLDOWN_SECONDS=10
AI_MAX_REPLIES_PER_HOUR=40
AI_MAX_MESSAGE_LENGTH=500
AI_TEMPERATURE=1
AI_REQUEST_TIMEOUT_MS=20000
GEMINI_API_KEY=your_gemini_api_key_here
# For OpenAI or an OpenAI-compatible endpoint:
# AI_PROVIDER=openai
# OPENAI_API_KEY / AI_API_KEY=...
# AI_BASE_URL=https://api.openai.com

# TempVC
# Configured via /tempvc setup command

# Music (requires a running Lavalink node)
MUSIC_ENABLED=true
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
LAVALINK_NODE_ID=main
MUSIC_DEFAULT_VOLUME=50
MUSIC_MAX_PLAYLIST_SIZE=50
MUSIC_ALLOW_SKIP=true
MUSIC_ALLOW_REPEAT=true

# Giveaways
GIVEAWAYS_ENABLED=true
GIVEAWAYS_CHANNEL_ID=
GIVEAWAYS_MAX_WINNERS=20

# Web Dashboard
SERVER_PORT=3000
