# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications → Bot → Reset Token.
# Never commit this file.
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
# Optional: register commands only in this guild for instant local updates.
DEV_GUILD_ID=

# Comma-separated Discord user IDs with bot-owner access.
OWNER_IDS=123456789012345678

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sukuna-bot?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Register slash commands globally on startup. Set DEV_GUILD_ID above for
# instant registration to one guild during development.
REGISTER_COMMANDS=true
# Skip migrations (kept for parity; Mongoose auto-creates collections).
SKIP_MIGRATIONS=false

# ---------------------------------------------------------------------------
# Optional AI — Gemini API
# ---------------------------------------------------------------------------
# Get your key from: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Sukuna AI Persona (Dashboard reads these or uses defaults)
# ---------------------------------------------------------------------------
# Enable/disable the AI persona
SUKUNA_ENABLED=true

# Channels where Sukuna can respond (comma-separated IDs)
SUKUNA_CHANNELS=123456789012345678,987654321098765432

# Persona display name
SUKUNA_DISPLAY_NAME=Sukuna

# Gemini model to use
SUKUNA_MODEL=gemini-3.1-flash

# Temperature (0.0 - 2.0)
SUKUNA_TEMPERATURE=1

# Max reply length in characters
SUKUNA_MAX_MESSAGE_LENGTH=2000

# ---------------------------------------------------------------------------
# Dashboard (web control panel)
# ---------------------------------------------------------------------------
# Start the dashboard alongside the bot. It also starts automatically when
# SUKUNA_ENABLED=true or when the persona was enabled from the dashboard.
DASHBOARD_ENABLED=true

# Access token for the dashboard login page. Minimum 8 characters.
# Leave empty and a random token is generated and printed once at startup
# (it is stored in memory only, so a restart generates a new one).
DASHBOARD_TOKEN=

# Port to listen on. bot-hosting.net sets SERVER_PORT automatically.
# SERVER_PORT=3001