{
  "name": "sukuna-bot",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc && npx tailwindcss -i ./src/web/public/css/styles.css -o ./src/web/public/css/styles.compiled.css --minify && cpy \"src/web/views/*\" dist/web/views/ && cpy \"src/web/public/**/*\" dist/web/public/",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/",
    "build:css": "npx tailwindcss -i ./src/web/public/css/styles.css -o ./src/web/public/css/styles.compiled.css --minify",
    "watch:css": "npx tailwindcss -i ./src/web/public/css/styles.css -o ./src/web/public/css/styles.compiled.css --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^2.30.0",
    "@napi-rs/canvas": "^1.0.12",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.14.0",
    "express": "^5.3.0",
    "lavalink-client": "^2.11.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "undici": "^6.29.1",
    "vitest": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "autoprefixer": "^10.6.2",
    "cpy-cli": "^7.0.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19"
  }
}
