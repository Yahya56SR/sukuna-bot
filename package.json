{
  "name": "sukuna-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Sukuna - all-in-one Discord bot (moderation, economy, leveling, tickets, fun, utility)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "bundle:bot": "node scripts/bundle-bot.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "discord.js": "^14.28.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
